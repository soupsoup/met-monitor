    "text": "\u092c\u0949\u0932\u0940\u0935\u0941\u0921 \u090f\u0915\u094d\u091f\u094d\u0930\u0947\u0938 \u0914\u0930 \u092e\u0949\u0921\u0932\u094d\u0938 \u0915\u094b \u0930\u093e\u0927\u093f\u0915\u093e \u0915\u093e \u0936\u0941\u0915\u094d\u0930\u0917\u0941\u091c\u093e\u0930 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u0915\u093f \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u092e\u0949\u0921\u0932\u093f\u0902\u0917 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u091c\u093e\u092f \u0939\u093e\u0909\u0938\u0935\u093e\u0907\u092b \u092c\u0928\u0928\u0947 \u0915\u093e \u092b\u0948\u0938\u0932\u093e \u0915\u093f\u092f\u093e\u0964\n\n\u0938\u094b\u091a\u093f\u090f \u0906\u092a \u090f\u0936\u093f\u092f\u093e \u0915\u0947 \u0938\u092c\u0938\u0947 \u0905\u092e\u0940\u0930 \u0906\u0926\u092e\u0940 \u0915\u0947 \u092c\u0947\u091f\u0947 \u0915\u0940 \u092a\u0924\u094d\u0928\u0940 \u0939\u0948\u0902, \u092b\u093f\u0930 \u092d\u0940 \u0906\u092a\u0915\u093e \u090f\u091f\u0940\u091f\u094d\u092f\u0942\u0921 \u091c\u093c\u0940\u0930\u094b \u0939\u0948, \u092e\u0947\u0915\u0905\u092a \u091c\u093c\u0940\u0930\u094b \u0939\u0948, \u0914\u0930 \u0906\u092a \u0917\u0930\u094d\u0935 \u0938\u0947 \u0939\u0930 \u0939\u093f\u0902\u0926\u0942 \u0930\u0940\u0924\u093f-\u0930\u093f\u0935\u093e\u091c \u0914\u0930 \u092a\u0930\u0902\u092a\u0930\u093e \u0915\u094b \u092e\u0928\u093e \u0930\u0939\u0940 \u0939\u0948\u0902\u0964 \u092e\u0941\u091d\u0947 \u0910\u0938\u0940 \u092c\u0939\u0941 \u092a\u0930 \u0917\u0930\u094d\u0935 \u0939\u0948! \ud83d\ude4f\n@iAKsSaviour",
